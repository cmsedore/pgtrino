ANALYZE local_k;
SET enable_hashjoin = off; SET enable_mergejoin = off;
EXPLAIN (COSTS OFF) SELECT l.k, t2.note FROM local_k l JOIN t2 USING (k);
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 Nested Loop
   ->  Seq Scan on local_k l
   ->  Foreign Scan on t2
         Trino SQL: SELECT "k", "note" FROM "mock"."s1"."t2" WHERE ($1 = "k")
(4 rows)

