   SubPlan 1
     ->  Foreign Scan
           Relations: Aggregate on (public.t2)
           Trino SQL: SELECT count(*) FROM "mock"."s1"."t2" WHERE ("note" IS NOT NULL) AND ("k" = $1)
(5 rows)

