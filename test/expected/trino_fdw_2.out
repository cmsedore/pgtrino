-- a non-shippable join clause: fine for an inner join, blocks an outer join
EXPLAIN (COSTS OFF) SELECT a.k FROM t2 a JOIN t1b b ON a.k = b.id AND a.note ~ b.name;
                                                            QUERY PLAN                                                            
----------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Filter: (note ~ (name)::text)
   Relations: (public.t2 a) INNER JOIN (public.t1b b)
   Trino SQL: SELECT r1."k", r1."note", r2."name" FROM ("mock"."s1"."t2" r1 INNER JOIN "mock"."s1"."t1" r2 ON (r1."k" = r2."id"))
(4 rows)

EXPLAIN (COSTS OFF) SELECT a.k FROM t2 a LEFT JOIN t1b b ON a.k = b.id AND a.note ~ b.name;
                            QUERY PLAN                             
-------------------------------------------------------------------
 Hash Right Join
   Hash Cond: (b.id = a.k)
   Join Filter: (a.note ~ (b.name)::text)
   ->  Foreign Scan on t1b b
         Trino SQL: SELECT "id", "name" FROM "mock"."s1"."t1"
   ->  Hash
         ->  Foreign Scan on t2 a
               Trino SQL: SELECT "k", "note" FROM "mock"."s1"."t2"
(8 rows)

-- a non-shippable WHERE clause on the nullable side blocks an outer join
EXPLAIN (COSTS OFF) SELECT a.k FROM t2 a LEFT JOIN t1b b ON a.k = b.id WHERE b.name ~ 'x' OR b.name IS NULL;
                                                      QUERY PLAN                                                      
----------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Filter: (((name)::text ~ 'x'::text) OR (name IS NULL))
   Relations: (public.t2 a) LEFT JOIN (public.t1b b)
   Trino SQL: SELECT r1."k", r2."name" FROM ("mock"."s1"."t2" r1 LEFT JOIN "mock"."s1"."t1" r2 ON (r1."k" = r2."id"))
(4 rows)

-- nested joins, with ORDER BY and LIMIT on top
EXPLAIN (COSTS OFF) SELECT a.k, b.id, c.k FROM t2 a JOIN t1b b ON a.k = b.id JOIN t2 c ON c.k = b.id + 1 ORDER BY a.k LIMIT 5;
                                                                                                           QUERY PLAN                                                                                                            
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Foreign Scan
   Relations: ((public.t2 a) INNER JOIN (public.t1b b)) INNER JOIN (public.t2 c)
   Trino SQL: SELECT r1."k", r2."id", r4."k" FROM (("mock"."s1"."t2" r1 INNER JOIN "mock"."s1"."t1" r2 ON (r1."k" = r2."id")) INNER JOIN "mock"."s1"."t2" r4 ON ((r2."id" + 1) = r4."k")) ORDER BY r1."k" ASC NULLS LAST LIMIT 5
(3 rows)

-- whole-row references and row marks keep the join local
EXPLAIN (COSTS OFF) SELECT a, b.id FROM t2 a JOIN t1b b ON a.k = b.id;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Hash Join
   Hash Cond: (b.id = a.k)
   ->  Foreign Scan on t1b b
         Trino SQL: SELECT "id" FROM "mock"."s1"."t1"
   ->  Hash
         ->  Foreign Scan on t2 a
               Trino SQL: SELECT "k", "v", "note" FROM "mock"."s1"."t2"
(7 rows)

EXPLAIN (COSTS OFF) SELECT a.k FROM t2 a JOIN t1b b ON a.k = b.id FOR UPDATE;
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 LockRows
   ->  Hash Join
         Hash Cond: (b.id = a.k)
         ->  Foreign Scan on t1b b
               Trino SQL: SELECT "id", "name", "val" FROM "mock"."s1"."t1"
         ->  Hash
               ->  Foreign Scan on t2 a
                     Trino SQL: SELECT "k", "v", "note" FROM "mock"."s1"."t2"
(8 rows)

-- tables on different servers are never joined remotely
CREATE SERVER mock2 FOREIGN DATA WRAPPER trino_fdw
  OPTIONS (host '127.0.0.1', port '18080', catalog 'mock', schema 's1');
CREATE USER MAPPING FOR PUBLIC SERVER mock2 OPTIONS (user 'tester');
CREATE FOREIGN TABLE t2_other (k bigint) SERVER mock2 OPTIONS (table_name 't2');
EXPLAIN (COSTS OFF) SELECT a.k FROM t2 a JOIN t2_other b ON a.k = b.k;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Nested Loop
   ->  Foreign Scan on t2 a
         Trino SQL: SELECT "k" FROM "mock"."s1"."t2"
   ->  Foreign Scan on t2_other b
         Trino SQL: SELECT "k" FROM "mock"."s1"."t2" WHERE ($1 = "k")
(5 rows)

